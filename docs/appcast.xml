    <!-- Previous Release -->
    <item>
      <title>Version 0.1.13</title>
      <sparkle:version>0.1.13</sparkle:version>
      <sparkle:shortVersionString>0.1.13</sparkle:shortVersionString>
      <pubDate>Sat, 28 Dec 2024 12:00:00 +0000</pubDate>
      <description><![CDATA[
        <h2>What's New in FSeq 0.1.13</h2>
        <h3>Renamer Redesign</h3>
        <ul>
          <li>Complete UI overhaul inspired by Windows PowerRename</li>
          <li>Vertical split layout with collapsible sections</li>
          <li>Token buttons in 2x3 grid for quick pattern insertion</li>
          <li>Per-item checkboxes to exclude specific files from rename</li>
          <li>Visual case buttons [Aa] [aa] [AA] [Aa Aa]</li>
          <li>Help dialog with two-column layout</li>
        </ul>
      ]]></description>

