    <item>
      <title>Version 0.2.0</title>
      <sparkle:version>0.2.0</sparkle:version>
      <sparkle:shortVersionString>0.2.0</sparkle:shortVersionString>
      <pubDate>Sun, 29 Dec 2024 12:00:00 +0000</pubDate>
      <description>
        &lt;h2&gt;What's New in FSeq 0.2.0&lt;/h2&gt;
        &lt;h3&gt;Features&lt;/h3&gt;
        &lt;ul&gt;
          &lt;li&gt;&lt;strong&gt;Undo support for rename operations&lt;/strong&gt; - Press Ctrl+Z to undo renames&lt;/li&gt;
          &lt;li&gt;UndoManager with session-based and persistent history&lt;/li&gt;
          &lt;li&gt;Store up to 20 operations for recovery after restart&lt;/li&gt;
        &lt;/ul&gt;
        &lt;h3&gt;Improvements&lt;/h3&gt;
        &lt;ul&gt;
          &lt;li&gt;Enhanced license security framework&lt;/li&gt;
          &lt;li&gt;Token support in renamer replace field&lt;/li&gt;
          &lt;li&gt;Preserve extension case in renamer&lt;/li&gt;
        &lt;/ul&gt;
      </description>
      <enclosure url="https://github.com/lasselauch/FSeq/releases/download/v0.2.0-unsigned/FSeq_0.2.0_unsigned.dmg" sparkle:os="macos" sparkle:edSignature="" length="45000000" type="application/octet-stream" />
