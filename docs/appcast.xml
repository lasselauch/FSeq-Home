    <item>
      <title>Version 0.1.13</title>
      <sparkle:version>0.1.13</sparkle:version>
      <sparkle:shortVersionString>0.1.13</sparkle:shortVersionString>
      <pubDate>Sat, 28 Dec 2024 12:00:00 +0000</pubDate>
      <description>
        &lt;h2&gt;What's New in FSeq 0.1.13&lt;/h2&gt;
        &lt;h3&gt;Renamer Redesign&lt;/h3&gt;
        &lt;ul&gt;
          &lt;li&gt;Complete UI overhaul inspired by Windows PowerRename&lt;/li&gt;
          &lt;li&gt;Vertical split layout with collapsible sections&lt;/li&gt;
          &lt;li&gt;Token buttons in 2x3 grid for quick pattern insertion&lt;/li&gt;
          &lt;li&gt;Per-item checkboxes to exclude specific files from rename&lt;/li&gt;
          &lt;li&gt;Visual case buttons [Aa] [aa] [AA] [Aa Aa]&lt;/li&gt;
          &lt;li&gt;Help dialog with two-column layout&lt;/li&gt;
        &lt;/ul&gt;
      </description>
