    <!-- Latest Release -->
    <item>
      <title>Version 0.2.0</title>
      <sparkle:version>0.2.0</sparkle:version>
      <sparkle:shortVersionString>0.2.0</sparkle:shortVersionString>
      <pubDate>Sun, 29 Dec 2024 12:00:00 +0000</pubDate>
      <description><![CDATA[
        <h2>What's New in FSeq 0.2.0</h2>
        <h3>Features</h3>
        <ul>
          <li><strong>Undo support for rename operations</strong> - Press Ctrl+Z to undo renames</li>
          <li>UndoManager with session-based and persistent history</li>
          <li>Store up to 20 operations for recovery after restart</li>
        </ul>
        <h3>Improvements</h3>
        <ul>
          <li>Enhanced license security framework</li>
          <li>Token support in renamer replace field</li>
          <li>Preserve extension case in renamer</li>
        </ul>
      ]]></description>

      <!-- macOS DMG (unsigned) -->
      <enclosure
        url="https://github.com/lasselauch/FSeq/releases/download/v0.2.0-unsigned/FSeq_0.2.0_unsigned.dmg"
        sparkle:os="macos"
